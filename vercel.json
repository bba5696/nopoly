{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/:path*", "destination": "https://nopoly.duckdns.org/:path*" }
  ],
  "headers": [
    {
      "source": "/socket.io/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
