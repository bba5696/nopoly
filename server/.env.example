# Copy to .env for local use. In production set these as real environment
# variables on the host instead of shipping a file.

# The shared password for the friend group. Required in production — the server
# refuses to start without it rather than quietly running open.
NOPOLY_PASSWORD=

# Turns on the admin panel at /admin, where you can see every room, kick a
# player or end a game. Off when unset, and refuses to turn on below 16
# characters — anyone holding this can see every room code on the server.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
NOPOLY_ADMIN_KEY=

# Turns on the production behaviour: the password requirement above, and no
# cross-origin allowance (the client is served from this same process).
NODE_ENV=production

# The host usually sets this itself.
PORT=3000

# Only needed if the client is hosted somewhere other than this server.
# Comma-separated, no trailing slash. e.g. https://nopoly.example.com
# CLIENT_ORIGIN=
