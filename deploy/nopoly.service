# systemd unit for the Nopoly game server.
#
# Install to /etc/systemd/system/nopoly.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now nopoly
#
# Adjust User/WorkingDirectory if you cloned somewhere else or your image's
# default account is `opc` (Oracle Linux) rather than `ubuntu`.

[Unit]
Description=Nopoly game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nopoly/server
ExecStart=/usr/bin/node index.js

# The password lives here, not in the repo. Keep it 600 and owned by root.
EnvironmentFile=/etc/nopoly.env

# Nginx terminates TLS and proxies to this, so it only needs to listen locally.
Environment=NODE_ENV=production
Environment=PORT=3000

Restart=always
RestartSec=3

# Every browser holds a socket, and each socket is a file descriptor. systemd's
# default of 1024 is a ceiling of roughly 900 players once the listener, the
# snapshot and the journal have taken theirs — and hitting it does not fail
# politely, it surfaces as EMFILE and refused connections while the server looks
# healthy. Raising it costs nothing; the real limit stays memory.
LimitNOFILE=65535

# Creates and owns /var/lib/nopoly, and passes it as $STATE_DIRECTORY. This is
# the only path the service can write to under ProtectSystem=strict below, and
# it is where running games are snapshotted so a redeploy doesn't end them.
StateDirectory=nopoly

# The snapshot is written on SIGTERM, before the sockets close — give it room
# to finish and to hand out its final broadcasts before systemd sends SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nopoly

# Modest hardening. The only thing the server writes is its state snapshot, and
# StateDirectory above punches the one hole needed for that.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
